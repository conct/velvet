generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  photoUrl         String?
  photoConfirmedAt DateTime?
  emailVerifiedAt  DateTime?
  // Marks a sandbox account (app-store reviewers, internal test logins).
  // Demo and production are kept as two disjoint worlds -- see
  // server/src/lib/demo.ts for what that means on both the read and the
  // write side.
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())

  relationships          VenueRelationship[]
  ratings                Rating[]
  entryLogs              EntryLog[]
  subscriptions          Subscription[]
  messagesSent           Message[]           @relation("MessagesSent")
  messagesReceived       Message[]           @relation("MessagesReceived")
  blocksMade             BlockedUser[]       @relation("BlocksMade")
  blocksReceived         BlockedUser[]       @relation("BlocksReceived")
  inviteCode             UserInviteCode?
  connectionsSent        ConnectionRequest[] @relation("ConnectionInvitee")
  connectionsReceived    ConnectionRequest[] @relation("ConnectionInviter")
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String
  logoUrl   String?
  status    String   @default("PENDING") // "PENDING" | "VERIFIED"
  // A sandbox venue: hidden from the public venue list, and nothing that
  // happens there counts towards anyone's trust score or history.
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  memberships   StaffVenueMembership[]
  relationships VenueRelationship[]
  ratings       Rating[]
  entryLogs     EntryLog[]
}

model StaffAccount {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  isPlatformAdmin Boolean  @default(false)
  // Sandbox staff account. May only scan and rate demo guests, and its
  // ratings never count towards a real guest's score.
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships      StaffVenueMembership[]
  ratings          Rating[]
  entryLogs        EntryLog[]
  messagesSent     Message[]              @relation("StaffMessagesSent")
  messagesReceived Message[]              @relation("StaffMessagesReceived")
}

model StaffVenueMembership {
  id             String   @id @default(cuid())
  staffAccountId String
  venueId        String
  // "DOORMAN" | "MANAGER" | "SERVICE" -- see staffRolePermissions in
  // packages/shared/src/types.ts for what each one may do. SERVICE is the
  // slimmer role for bar/service staff at small locations: it may look guests
  // up and scan/rate them like DOORMAN, but never manage the team.
  role           String
  createdAt      DateTime @default(now())

  staffAccount StaffAccount @relation(fields: [staffAccountId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])

  @@unique([staffAccountId, venueId])
}

model VenueRelationship {
  id          String    @id @default(cuid())
  userId      String
  venueId     String
  visits      Int       @default(0)
  lastVisitAt DateTime?
  localFlag   String    @default("NONE") // "NONE" | "VIP" | "BANNED"
  privateNote String?
  // Set when the guest hides this location from their own history (see
  // POST /users/me/venues/:venueId/hide). Deliberately one-directional and
  // one-way: it changes nothing about the venue's own records or the guest's
  // trust score, and only support can clear it again.
  hiddenAt    DateTime?

  user  User  @relation(fields: [userId], references: [id])
  venue Venue @relation(fields: [venueId], references: [id])

  @@unique([userId, venueId])
}

model Rating {
  id             String   @id @default(cuid())
  userId         String
  venueId        String
  staffAccountId String
  stars          Int
  tags           String   @default("[]") // JSON-encoded string[]
  note           String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])
  staffAccount StaffAccount @relation(fields: [staffAccountId], references: [id])
}

model EntryLog {
  id             String   @id @default(cuid())
  userId         String
  venueId        String
  staffAccountId String
  scannedAt      DateTime @default(now())
  rated          Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id])
  venue        Venue        @relation(fields: [venueId], references: [id])
  staffAccount StaffAccount @relation(fields: [staffAccountId], references: [id])

  @@index([venueId, scannedAt])
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  provider           String // "STRIPE" | "PAYPAL"
  providerCustomerId String?
  providerSubId      String   @unique
  status             String // "ACTIVE" | "PAST_DUE" | "CANCELED" | "INCOMPLETE"
  interval           String // "MONTH" | "YEAR"
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Message {
  id                      String    @id @default(cuid())
  senderId                String?
  senderStaffAccountId    String?
  recipientId             String?
  recipientStaffAccountId String?
  body                    String
  createdAt               DateTime  @default(now())
  readAt                  DateTime?
  reportedAt              DateTime?
  reportReason            String?
  externalSenderEmail     String?
  externalSenderName      String?
  viaEmailRelay           Boolean   @default(false)

  sender                User?         @relation("MessagesSent", fields: [senderId], references: [id])
  senderStaffAccount    StaffAccount? @relation("StaffMessagesSent", fields: [senderStaffAccountId], references: [id])
  recipient             User?         @relation("MessagesReceived", fields: [recipientId], references: [id])
  recipientStaffAccount StaffAccount? @relation("StaffMessagesReceived", fields: [recipientStaffAccountId], references: [id])

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  accountType String // "user" | "staff"
  accountId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([accountId, accountType])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id])
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

// A user's personal, shareable connect code/link (QR + URL), analogous to the
// venue Werbematerial QR but for user-to-user invites instead of location
// marketing. One per user; rotating it invalidates any previously shared
// link/QR without affecting existing accepted connections.
model UserInviteCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Someone using an invite code/link sends a request to the code's owner, who
// must accept before a chat opens -- protects the owner (e.g. an influencer
// sharing their code widely) from being contacted by just anyone who scans
// it. Once ACCEPTED, canMessage() in lib/messaging.ts allows the pair to
// message regardless of the separate Premium/shared-night eligibility path.
model ConnectionRequest {
  id          String    @id @default(cuid())
  inviterId   String
  inviteeId   String
  status      String    @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  inviter User @relation("ConnectionInviter", fields: [inviterId], references: [id])
  invitee User @relation("ConnectionInvitee", fields: [inviteeId], references: [id])

  @@unique([inviterId, inviteeId])
}

// A small bar/pub applying to join VELVET through the public self-service
// form (apps/dashboard/app/location-anmelden) instead of being set up by
// hand. Nothing here grants access on its own: the business-registration
// document is reviewed by a platform admin, who then creates the actual
// Venue and its first MANAGER account (see routes/admin.ts). The uploaded
// document is deliberately NOT stored under server/uploads (that directory
// is served publicly at /uploads) but under server/private-uploads, and is
// only readable through the admin-only download route.
model VenueApplication {
  id             String    @id @default(cuid())
  venueName      String
  venueType      String // "CLUB" | "BAR" | "PUB" | "OTHER"
  address        String
  website        String?
  contactName    String
  contactEmail   String
  contactPhone   String?
  message        String?
  documentName   String // original filename, for the admin list only
  documentPath   String // filename inside server/private-uploads
  documentMime   String
  status         String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdVenueId String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}
